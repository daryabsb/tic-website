# Copy to /srv/stacks/tic/<env>/backup.env on the server (never in git; mode 600).
# Tells the platform's bin/backup-stack, bin/restore-stack, bin/deploy and
# bin/run-task what this stack is (stack contract item 5).
# Sourced by bash: quote any value that contains spaces.

# --- What -------------------------------------------------------------------
DB_ENGINE=postgres
DB_SERVICE=db
DB_NAME=tic
DB_USER=tic
MEDIA_DIR=media

# --- Where: one restic repository per stack env ------------------------------
# Same B2 bucket as MLP, own prefix. Staging: .../tic-staging
RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/zeneon-backups/tic-prod
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Alerts -----------------------------------------------------------------
# Healthchecks.io check for this stack env's backup (ticket #12).
HC_PING_URL=

# --- Hooks (platform defaults suit this Django app) --------------------------
# WEB_SERVICE=web
# MIGRATE_CMD="python manage.py migrate --noinput"
# TASK_PREFIX="python manage.py"
