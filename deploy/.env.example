# TIC stack environment. Copy to /srv/stacks/tic/<env>/.env on the
# server: mode 600, owner deploy. Never in git. Fill every empty value.
# Read by "web" (env_file) and by Compose for the ${POSTGRES_*} values of "db".

# production | staging
DJANGO_ENV=production

# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Production host per P-1 (ticqc.com or ticqc.ae). Staging: deploy/staging/env.example (D27)
ALLOWED_HOSTS=ticqc.com,www.ticqc.com
WAGTAILADMIN_BASE_URL=https://ticqc.com

POSTGRES_DB=tic
POSTGRES_USER=tic
POSTGRES_PASSWORD=
# postgres://tic:<POSTGRES_PASSWORD>@db:5432/tic
DATABASE_URL=

# Email through Microsoft 365 (D43): the app registration "TIC website" (Graph
# Mail.Send, limited to the shared mailbox website@ticqc.com). Set: MS365 is used;
# blank: Resend (RESEND_API_KEY). Every From address must be that mailbox.
# The visitor's Reply-To is the routed office, else REPLY_TO_EMAIL.
MS365_TENANT_ID=
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=TIC Quality Control <website@ticqc.com>
REQUESTS_FROM_EMAIL=TIC Quality Control <website@ticqc.com>
REPLY_TO_EMAIL=info@ticqc.com
SERVER_EMAIL=website@ticqc.com
# "Name <address>"
ADMINS=

# Before every alert and client email. Blank on prod; on staging blank means [staging].
NOTIFY_PREFIX=

# Cloudflare cache purge when editors publish (Wagtail frontend cache). Token with
# Zone > Cache Purge only, zone ticqc.com. Blank: nothing is purged (staging).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Spam-check widget keys: hCaptcha (D8, D33; dashboard.hcaptcha.com)
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# Umami site id (master plan 11); the SEO tag reads it from SiteSettings, seeded from here.
UMAMI_WEBSITE_ID=

# True only on production after launch (master plan 10).
# Languages visitors can reach on production; add ar after the reviewer signs off (master plan 08).
SITE_PUBLIC_LANGUAGES=en

SITE_INDEXABLE=False

LOG_LEVEL=INFO
