# Weekly staging backup (D27). Installed to /etc/systemd/system/ by
# scripts/deploy-staging-remote.sh on stms-data.
[Unit]
Description=TIC staging backup to the NAS
After=docker.service remote-fs.target
Requires=docker.service

[Service]
Type=oneshot
User=darya
ExecStart=/usr/bin/bash /home/darya/tic/staging/backup.sh
