# TIC staging environment (D27). deploy-staging-remote.sh copies this to
# ~/tic/staging/.env on stms-data (mode 600) on the first deploy and fills the
# generated values (SECRET_KEY, POSTGRES_PASSWORD, DATABASE_URL, the basic-auth hash).
# Never in git. Read by "web" (env_file) and by Compose for ${...} in compose.yaml.

DJANGO_ENV=staging
SECRET_KEY=
ALLOWED_HOSTS=staging.ticqc.ae
WAGTAILADMIN_BASE_URL=https://staging.ticqc.ae

POSTGRES_DB=tic
POSTGRES_USER=tic
POSTGRES_PASSWORD=
DATABASE_URL=

# Cloudflare Zero Trust -> Networks -> Tunnels -> tic-staging -> token.
# Public hostname staging.ticqc.ae -> HTTP caddy:80.
TUNNEL_TOKEN=

# Caddy basic auth, user "review". The plain password is in ~/tic/staging/basic-auth.txt.
TIC_STAGING_BASIC_AUTH_HASH=

# Email through Resend (master plan 07). Blank: staging sends no mail (T17 needs it).
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=TIC Quality Control <no-reply@ticqc.ae>
REQUESTS_FROM_EMAIL=TIC Quality Control <requests@ticqc.ae>
REPLY_TO_EMAIL=info@ticqc.ae
SERVER_EMAIL=requests@ticqc.ae
ADMINS=
NOTIFY_PREFIX=[staging]

# Spam check: hCaptcha's always-pass test keys until TIC has its own account (D33).
HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET_KEY=0x0000000000000000000000000000000000000000

UMAMI_WEBSITE_ID=
SITE_INDEXABLE=False
LOG_LEVEL=INFO

# Healthchecks.io check "tic-staging-backup" (weekly, grace 1 day). Blank: no ping.
HC_PING_URL=
